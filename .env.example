# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Opcional: com o domínio, o jogador digita só "nome.sobrenome"
VITE_ALLOWED_EMAIL_DOMAIN=suaempresa.com.br
# Opcional: Pix dos Manipulados (chave CPF, email, telefone +55... ou aleatória). Sem os três, não há "Manipular"
VITE_PIX_KEY=12345678901
VITE_PIX_NAME=Seu Nome
VITE_PIX_CITY=Sao Paulo
